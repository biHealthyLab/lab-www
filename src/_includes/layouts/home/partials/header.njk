<section id="home">
    <!-- Header -->
	<div class="intro-header">
		{# <div class=""> #}
			{# <div class="row"> #}
				<div class="showcase col-lg-12">
                    <video id="bground-video" autoplay loop playsinline muted preload="metadata" poster="{{ site.heroPoster | url }}" aria-hidden="true" tabindex="-1">
                        <source src="{{ site.backgroundVid | url }}" type="video/mp4">
                    </video>
					<button type="button" class="hero-video-toggle btn btn-outline-light" data-video-toggle aria-label="Pause background video">
						<i class="fas fa-pause" aria-hidden="true"></i>
					</button>
					<div class="intro-message">
                        <div class="main-teaser">
                            <h1 class="text-white animated zoomIn">{{ site.mainTeaser |safe }}</h1>
                        </div>
                        <div class="container main-title">
                            <hr class="intro-divider">
                           <h4 class="text-white animated zoomIn">{{ site.homeTitle |safe }}</h4>
                        </div>
					</div>
				</div>
			{# </div> #}
		{# </div> #}
		<!-- /.container -->
	</div>

    {# {% include "./partners.njk" %} #}

	<!-- /.intro-header -->
</section>

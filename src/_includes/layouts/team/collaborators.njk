<!-- Collaborators Section -->
<section id="collaborators" class="research-areas-section" aria-labelledby="collaborators-heading">
    <div class="container">
        <div class="mx-auto text-center wow fadeInUp" data-wow-delay="0.1s">
            
            <h2 id="collaborators-heading" class="mb-5 headline"><span>Our collaborators</span></h2>
        </div>
        <div class="row" >
            {% for c in collaborators %}
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="card-body bcard clickable">
                  
                    {% if c.url %}<a href="{{ c.url | url }}" target="_blank" rel="noopener noreferrer"><b>{{c.name}}</b></a>{% else %}<b>{{ c.name }}</b>{% endif %}<br>
                    <small>
                    {% for aff in c.affiliations %}
                        {{aff}}{%- if not loop.last -%}, {% endif -%}
                    {% endfor %}
                    </small>

                    <br>
                    <i class="text-muted">
                    {% for loc in c.locations %}
                        {{loc}} {%- if not loop.last -%}, {% endif -%}
                    {% endfor %}
                    </i>
                

                </div>
            </div>
            {% endfor %}

            
            
        </div>
    </div>
</section>

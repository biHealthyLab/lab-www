{% extends "layouts/base.njk" %}

{% block page_header %}
{% include "layouts/page_header.njk" %}
{% endblock %}


{% block page_main_content %}
<div class="container-xxl">
    <div class="col-md-6 mx-auto ml-2">
        
        {% for n in collections.news | reverse %}
            <details class="details-card" id="news-{{ n.data.title|slugify }}">
              <summary class="news-list-card__summary{% if n.data.front_image %} news-list-card__summary--with-image{% endif %}">
                {% if n.data.front_image %}
                  <span class="news-list-card__image" aria-hidden="true">
                    <img src="{{ n.data.front_image | url }}" alt="" loading="lazy" decoding="async">
                  </span>
                {% endif %}
                <span class="news-list-card__summary-body">
                  {% if n.data.type %}<span class="news-list-card__type"><span class="badge btn-{{n.data.type}}">{{ n.data.type }}</span></span>{% endif %}
                  <time class="text-muted" datetime="{{ n.data.date | isoDate }}">{{ n.data.date|readableDate}}</time>
                  <strong>{% if n.data.thumbs_up == 'Yes' %}
                      <i class="fa fa-thumbs-up" aria-hidden="true"></i>
                  {% endif %} <a class="news-list-title-link" href="{{ n.url | url }}">{{ n.data.title | trim | safe }}</a></strong>
                </span>
              </summary>
              <div class="details-card__content">
            {% if n.data.link %}
                <p><i class="fas fa-link" aria-hidden="true"></i> <a href="{{n.data.link|url}}" target="_blank" rel="noopener noreferrer">View the related source</a></p>
            {% endif %}
            <div>
                {{ n.templateContent|safe }}
            </div>
            <p class="mb-0"><a class="news-list-story-link" href="{{ n.url | url }}">Read this update <span aria-hidden="true">→</span></a></p>
              </div>
            </details>
        {% endfor %}
        
        
    </div>
</div>
{% endblock %}
            

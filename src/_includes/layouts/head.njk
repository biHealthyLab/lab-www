{% set pageTitle = title or full_name or site.shortName %}
{% set shareImage = front_image or site.logo %}
<meta charset="utf-8">
<title>{{ pageTitle | trim }} | {{ site.shortName }}</title>
<meta content="width=device-width, initial-scale=1.0" name="viewport">
{% if keywords %}<meta content="{{ keywords }}" name="keywords">{% endif %}
<meta content="{{ metaDescription or teaser or short_description or site.metaDescription }}" name="description">
{% if noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
<link href="{{ site.url }}{{ page.url }}" rel="canonical">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.shortName }}">
<meta property="og:title" content="{{ pageTitle | trim }} | {{ site.shortName }}">
<meta property="og:description" content="{{ metaDescription or teaser or short_description or site.metaDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ shareImage }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle | trim }} | {{ site.shortName }}">
<meta name="twitter:description" content="{{ metaDescription or teaser or short_description or site.metaDescription }}">
<meta name="twitter:image" content="{{ site.url }}{{ shareImage }}">

<!-- Favicon -->
<link href="{{ site.logo | url }}" rel="icon" type="image/png">

<!-- Google Web Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css?family=Roboto" rel="stylesheet"> 

<!-- Icon Font Stylesheet -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
<link href="{{ '/assets/css/bootstrap-icons.css' | url }}" rel="stylesheet">

<!-- Customized Bootstrap Stylesheet -->
<link href="{{ '/assets/css/bootstrap.css' | url }}" rel="stylesheet">


<!-- Template Stylesheet -->
<link href="{{ '/assets/css/style.css' | url }}?v={{ site.assetVersion }}" rel="stylesheet">


<!-- MathJax renders TeX expressions written as $...$ or $$...$$ in Markdown. -->
<script>
window.MathJax = {
  tex: {
    inlineMath: {'[+]': [['$', '$']]},
    processEscapes: true,
    tags: 'ams'
  }
};
</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@4/tex-mml-chtml.js"></script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ResearchOrganization",
  "name": "{{ site.title }}",
  "alternateName": "{{ site.shortName }}",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}{{ site.logo }}",
  "email": "{{ site.contactEmail }}",
  "telephone": "{{ site.phone }}",
  "parentOrganization": {
    "@type": "CollegeOrUniversity",
    "name": "Concordia University",
    "url": "https://www.concordia.ca/"
  }
}
</script>

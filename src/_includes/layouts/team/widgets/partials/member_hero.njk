
{% for m in collections.members | sortByCategory %}

<section class="section-xxl member-hero hero-{% if loop.index%2 == 1 %}odd{% else %}even{% endif %}">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-4 img-hero-wrapper">
                    <picture>
                      <source srcset="{{ m.data.profile_img | webpPath | url }}" type="image/webp">
                      <img src="{{ m.data.profile_img | url }}" alt="Portrait of {{m.data.full_name}}" class="img-hero" width="250" height="250" loading="lazy" decoding="async">
                    </picture>
                
            </div>
            <div class="col-lg-8 col-md-8 col-sm-8 hero-content">
            
                <div class="">
                    <h4><a href="{{ m.url }}">{{m.data.full_name}}, <small>{{m.data.credentials}}</small></a> </h4>
                    <small class="text-muted"> {{m.data.position}} </small>
                    <hr>
                    <p>
                        {{ m.data.presentation | safe}}
                    <p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endfor %}

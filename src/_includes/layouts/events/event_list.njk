{% extends "layouts/base.njk" %}

{% block page_header %}
{% include "layouts/page_header.njk" %}
{% endblock %}

{% block page_main_content %}
<div class="container-xxl">
  <div class="col-md-8 mx-auto ml-2">
    {% set upcomingEvents = collections.events | futureEvents %}
    {% set pastEventItems = collections.events | pastEvents %}

    <section aria-labelledby="upcoming-events-heading" class="mb-5">
      <h2 id="upcoming-events-heading" class="headline mb-4"><span>Upcoming events</span></h2>
      {% if upcomingEvents.length == 0 %}
        <p class="text-center text-muted">No upcoming events are currently listed. Please check back soon.</p>
      {% endif %}
      {% for e in upcomingEvents %}
        {% include "./event_item.njk" %}
      {% endfor %}
    </section>

    <section aria-labelledby="past-events-heading">
      <h2 id="past-events-heading" class="headline mb-4"><span>Past events</span></h2>
      {% for e in pastEventItems %}
        {% include "./event_item.njk" %}
      {% endfor %}
    </section>
  </div>
</div>
{% endblock %}
